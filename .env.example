# Park Now JP - Environment Variables
# このファイルを .env.local にコピーして使ってください

# MapTiler API キー（任意。無料枠で月10万リクエスト）
# https://maptiler.com で取得
NEXT_PUBLIC_MAPTILER_KEY=

# 本番デプロイ先 URL（PWA manifest 用）
NEXT_PUBLIC_SITE_URL=https://park-now-jp.vercel.app

# Web Push 通知用 VAPID キー（Phase 4 で必要）
# 生成: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
